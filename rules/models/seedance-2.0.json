    "section_order": ["generation_goal", "reference_duties", "subjects_relations", "event_script", "consistency"],
    "empty_negative": "无",
    "empty_dialogue": "无对白；人物自然闭口，无旁白"
  },
  "prompt_guidance": {
    "long_shot_staging_threshold_sec": 15,
    "shot_structure": "先按完整过程组织视频，再在视频内部安排镜头。默认按镜头顺序叙述，不写数字时间戳；用户要求显示时间轴时，每个视觉镜头、对白和声音 cue 都要带秒数。完整过程在上限内不得因切镜拆成多段提示词。",
    "dialogue": "台词语言以中文、英语为主且需统一，避免中英文混用（专有名词除外）；小语种台词必须标注语种。保留原文逐字内容，不因镜头切换重起、截断或重复。",
