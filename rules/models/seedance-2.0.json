      "style": "风格",
      "continuity": "连续性",
      "negative": "负面约束"
    },
    "section_order": [
      "subject_action",
      "setting_time",
      "camera",
      "light_color",
      "style",
      "continuity",
      "negative"
    ],
    "empty_negative": "无"
  },
