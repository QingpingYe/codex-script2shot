#!/bin/sh
set -eu

launcher_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
script_path=$launcher_dir/setup_bootstrap.mjs

if [ ! -f "$script_path" ]; then
  printf '%s\n' "setup_bootstrap 缺失：找不到 $script_path" >&2
  exit 1
fi

codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac
cache_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}

for candidate in \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "$codex_resources/cua_node/bin/node" \
  "$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$script_path" "$@"
  fi
done

# Claude Code 等宿主不自带 Node：优先复用 setup 安装的私有运行时（可用
# SCRIPT2SHOT_HOME 覆盖 home），再退回系统 node。
script2shot_home=${SCRIPT2SHOT_HOME:-${HOME:-}/.codex-script2shot}
for candidate in "$script2shot_home"/runtime/node-*/node-*/bin/node; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$script_path" "$@"
  fi
done

if command -v node >/dev/null 2>&1; then
  exec node "$script_path" "$@"
fi

printf '%s\n' '未找到可用的 Node 运行时；请安装 Node.js >= 24 后重试。' >&2
exit 127
