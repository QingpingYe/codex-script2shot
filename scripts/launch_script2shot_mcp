#!/bin/sh
set -eu

launcher_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
server_path=$launcher_dir/../server/dist/server.mjs

if [ ! -f "$server_path" ]; then
  printf '%s\n' "script2shot MCP Server 尚未构建：找不到 $server_path" >&2
  printf '%s\n' "请先运行：npm --prefix server run build" >&2
  printf '%s\n' "也可由 scripts/setup_bootstrap build-server 自动完成（安装依赖 + 构建 + 握手自检）" >&2
  exit 1
fi

codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac
cache_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}

for candidate in \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:-}/cua_node/bin/node" \
  "$codex_resources/cua_node/bin/node" \
  "$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$server_path" "$@"
  fi
done

if command -v node >/dev/null 2>&1; then
  exec node "$server_path" "$@"
fi

printf '%s\n' '请更新 Codex 或安装 Node.js >= 24' >&2
exit 127
